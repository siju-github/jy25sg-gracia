# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APPS_SCRIPT_URL: Google Apps Script Web App URL for direct Google Sheets registration syncing.
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/.../exec"

# WalletWallet API Key for Apple Wallet & Google Wallet pass generation (walletwallet.dev)
# Configure WALLETWALLETI_API_KEY in Settings -> Secrets with key starting with ww_live_
WALLETWALLETI_API_KEY=""

# HitPay Payment Gateway Configuration (Dynamic PayNow QR & Direct Checkout)
# Configure HITPAY_API_KEY in Settings -> Secrets with your HitPay API Key
HITPAY_API_KEY=""
# HITPAY_ENV: "production" (or "live") for live gateway, "sandbox" for test gateway
HITPAY_ENV="production"
# HITPAY_SALT: HitPay Webhook Salt for HMAC-SHA256 signature verification (HitPay Dashboard -> Settings -> Webhooks)
HITPAY_SALT=""

# SMTP Settings for jysg25@jesusyouth.org direct email dispatch
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="jysg25@jesusyouth.org"
SMTP_PASS=""
